{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', ':semanticCommits', 'schedule:weekends', 'group:allNonMajor'],
  reviewers: ['arpitanandzethic'],
  labels: ['dependencies'],
  rangeStrategy: 'bump',
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 5am on monday'],
  },
  packageRules: [
    {
      description: 'Group Radix UI packages together',
      groupName: 'Radix UI packages',
      matchPackageNames: ['/^@radix-ui//'],
    },
    {
      description: 'Group TanStack packages together',
      groupName: 'TanStack packages',
      matchPackageNames: ['/^@tanstack//'],
    },
    {
      description: 'Group dnd-kit packages together',
      groupName: 'dnd-kit packages',
      matchPackageNames: ['/^@dnd-kit//'],
    },
    {
      description: 'Group testing packages',
      groupName: 'testing packages',
      matchPackageNames: ['/jest/', '/testing-library/', '/playwright/'],
    },
    {
      description: 'Group linting packages',
      groupName: 'linting packages',
      matchPackageNames: ['/eslint/', '/prettier/', '/commitlint/', '/lint-staged/'],
    },
    {
      description: 'Group TypeScript packages',
      groupName: 'TypeScript packages',
      matchPackageNames: ['/typescript/', '/^@types//', '/ts-jest/', '/ts-node/'],
    },
    {
      description: 'Major updates require extra attention',
      matchUpdateTypes: ['major'],
      labels: ['dependencies', 'major'],
    },
  ],
  vulnerabilityAlerts: {
    enabled: true,
    labels: ['security'],
  },
}
